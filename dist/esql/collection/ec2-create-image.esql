// AWS EC2 AMI Created From Instance  [tier: hunt]  ATT&CK: T1530
// Detects creation of an AMI from a running instance (CreateImage). Captures the instance's disk (and any secrets on it); often paired with…
// False positives: Image-bakery and backup workflows.
// Source: rules/collection/ec2-create-image.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="CreateImage" and eventSource=="ec2.amazonaws.com"
