// AWS SSM Parameter Retrieved With Decryption  [tier: hunt]  ATT&CK: T1555.006
// Detects retrieval of SSM Parameter Store parameters with decryption (GetParameter/GetParameters/GetParametersByPath with…
// False positives: Applications reading their own SecureString parameters at runtime.
// Source: rules/credential-access/ssm-get-parameter-decrypt.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where (eventName in ("GetParameter", "GetParameters", "GetParametersByPath")) and eventSource=="ssm.amazonaws.com" and requestParameters.withDecryption==true
