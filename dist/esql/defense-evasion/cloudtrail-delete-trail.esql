// AWS CloudTrail Trail Deleted  [tier: alert]  ATT&CK: T1562.008
// Detects deletion of a CloudTrail trail (DeleteTrail), removing the audit trail entirely.
// False positives: Decommissioning of a trail as part of an approved change.
// Source: rules/defense-evasion/cloudtrail-delete-trail.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="DeleteTrail" and eventSource=="cloudtrail.amazonaws.com"
