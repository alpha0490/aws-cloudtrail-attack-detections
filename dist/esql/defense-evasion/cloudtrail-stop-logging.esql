// AWS CloudTrail Logging Stopped  [tier: alert]  ATT&CK: T1562.008
// Detects StopLogging on a CloudTrail trail, which halts delivery of management/data events - a direct attempt to blind defenders.
// False positives: Rare, planned maintenance on a trail (should be change-controlled).
// Source: rules/defense-evasion/cloudtrail-stop-logging.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="StopLogging" and eventSource=="cloudtrail.amazonaws.com"
