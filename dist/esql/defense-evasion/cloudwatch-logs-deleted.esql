// AWS CloudWatch Log Group or Stream Deleted  [tier: hunt]  ATT&CK: T1562.008, T1070
// Detects deletion of CloudWatch Logs groups or streams (DeleteLogGroup/DeleteLogStream), destroying application/audit logs.
// False positives: Lifecycle management of log groups.
// Source: rules/defense-evasion/cloudwatch-logs-deleted.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where (eventName in ("DeleteLogGroup", "DeleteLogStream")) and eventSource=="logs.amazonaws.com"
