// AWS VPC Flow Logs Deleted  [tier: alert]  ATT&CK: T1562.008
// Detects deletion of VPC flow logs (DeleteFlowLogs), removing network-level visibility.
// False positives: Decommissioning of flow logs during network changes.
// Source: rules/defense-evasion/vpc-delete-flow-logs.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="DeleteFlowLogs" and eventSource=="ec2.amazonaws.com"
