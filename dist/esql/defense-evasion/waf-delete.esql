// AWS WAF Rule or WebACL Deleted  [tier: hunt]  ATT&CK: T1562.001
// Detects deletion of AWS WAF protections (DeleteWebACL/DeleteRuleGroup/DeleteIPSet), removing application-layer defenses.
// False positives: Legitimate WAF reconfiguration.
// Source: rules/defense-evasion/waf-delete.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where (eventName in ("DeleteWebACL", "DeleteRuleGroup", "DeleteIPSet")) and eventSource like "*waf*"
