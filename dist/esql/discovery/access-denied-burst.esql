// AWS Permission Enumeration via Access Denied Burst  [tier: hunt]  ATT&CK: T1087.004, T1069.003
// Detects a single principal generating AccessDenied errors across 3 or more distinct API actions within 30 minutes - characteristic of…
// False positives: n/a
// Source: rules/discovery/access-denied-burst.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where errorCode like "*AccessDenied*"
| eval timebucket=date_trunc(30minutes, @timestamp) | stats value_count=count_distinct(eventName) by timebucket, userIdentity.arn
| where value_count >= 3
