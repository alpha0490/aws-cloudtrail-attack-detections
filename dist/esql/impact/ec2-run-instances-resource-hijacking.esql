from * metadata _id, _index, _version | where eventName=="RunInstances" and eventSource=="ec2.amazonaws.com" and (starts_with(requestParameters.instanceType, "p2") or starts_with(requestParameters.instanceType, "p3") or starts_with(requestParameters.instanceType, "p4") or starts_with(requestParameters.instanceType, "p5") or starts_with(requestParameters.instanceType, "g3") or starts_with(requestParameters.instanceType, "g4") or starts_with(requestParameters.instanceType, "g5") or starts_with(requestParameters.instanceType, "g6") or starts_with(requestParameters.instanceType, "x1") or starts_with(requestParameters.instanceType, "x2") or starts_with(requestParameters.instanceType, "inf1") or starts_with(requestParameters.instanceType, "inf2") or starts_with(requestParameters.instanceType, "trn1") or starts_with(requestParameters.instanceType, "dl1"))
