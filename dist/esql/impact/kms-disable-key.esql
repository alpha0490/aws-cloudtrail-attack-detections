// AWS KMS Key Disabled or Policy Weakened  [tier: alert]  ATT&CK: T1486
// Detects disabling a KMS key or its rotation, or rewriting its policy (DisableKey/DisableKeyRotation/PutKeyPolicy). Can break decryption…
// False positives: Legitimate key administration (review the change).
// Source: rules/impact/kms-disable-key.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where (eventName in ("DisableKey", "DisableKeyRotation", "PutKeyPolicy")) and eventSource=="kms.amazonaws.com"
