// AWS RDS Database Deleted  [tier: alert]  ATT&CK: T1485
// Detects deletion of RDS databases/clusters (DeleteDBInstance/DeleteDBCluster). Destructive; especially severe when SkipFinalSnapshot=true.
// False positives: Planned decommissioning of databases.
// Source: rules/impact/rds-delete-db-instance.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where (eventName in ("DeleteDBInstance", "DeleteDBCluster")) and eventSource=="rds.amazonaws.com"
