// AWS RDS Snapshot Deleted  [tier: hunt]  ATT&CK: T1490
// Detects deletion of RDS snapshots (DeleteDBSnapshot/DeleteDBClusterSnapshot), removing database recovery points.
// False positives: Snapshot lifecycle/retention cleanup.
// Source: rules/impact/rds-delete-db-snapshot.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where (eventName in ("DeleteDBSnapshot", "DeleteDBClusterSnapshot")) and eventSource=="rds.amazonaws.com"
