// AWS S3 Bucket Deleted  [tier: alert]  ATT&CK: T1485
// Detects deletion of an S3 bucket (DeleteBucket). Destructive action that can cause data loss/outage.
// False positives: Decommissioning of unused buckets (should be change-controlled).
// Source: rules/impact/s3-delete-bucket.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="DeleteBucket" and eventSource=="s3.amazonaws.com"
