// AWS Console Login Brute Force From Single Source IP  [tier: alert]  ATT&CK: T1110
// Detects 5 or more failed console logins from a single source IP within 10 minutes, indicating brute-force/credential-stuffing against the…
// False positives: n/a
// Source: rules/initial-access/brute-force-console-login.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="ConsoleLogin" and eventSource=="signin.amazonaws.com" and responseElements.ConsoleLogin=="Failure"
| eval timebucket=date_trunc(10minutes, @timestamp) | stats event_count=count() by timebucket, sourceIPAddress
| where event_count >= 5
