// AWS Console Login Without MFA  [tier: hunt]  ATT&CK: T1078.004
// Detects a successful console sign-in where MFA was not used (additionalEventData.MFAUsed=No). For IAM users this is a control gap; for…
// False positives: Federated/SSO logins where MFA is enforced at the IdP and reported as No.
// Source: rules/initial-access/console-login-without-mfa.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="ConsoleLogin" and eventSource=="signin.amazonaws.com" and responseElements.ConsoleLogin=="Success" and additionalEventData.MFAUsed=="No"
