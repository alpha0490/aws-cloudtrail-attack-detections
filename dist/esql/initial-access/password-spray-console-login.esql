// AWS Console Login Password Spray From Single Source IP  [tier: alert]  ATT&CK: T1110.003
// Detects a single source IP generating failed console logins for 3 or more distinct usernames within 1 hour, indicating password spraying.
// False positives: n/a
// Source: rules/initial-access/password-spray-console-login.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="ConsoleLogin" and eventSource=="signin.amazonaws.com" and responseElements.ConsoleLogin=="Failure"
| eval timebucket=date_trunc(1hours, @timestamp) | stats value_count=count_distinct(userIdentity.userName) by timebucket, sourceIPAddress
| where value_count >= 3
