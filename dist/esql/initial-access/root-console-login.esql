// AWS Root Account Console Login  [tier: alert]  ATT&CK: T1078.004
// Detects an interactive console sign-in by the AWS account root user. Root login should be extremely rare and reserved for tasks that…
// False positives: Pre-approved break-glass or account-level maintenance that genuinely requires root.
// Source: rules/initial-access/root-console-login.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="ConsoleLogin" and eventSource=="signin.amazonaws.com" and userIdentity.type=="Root"
