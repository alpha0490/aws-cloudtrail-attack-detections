// AWS IAM Access Key Created  [tier: hunt]  ATT&CK: T1098.001
// Detects creation of an IAM access key (CreateAccessKey). High-signal when the key is created for a DIFFERENT user than the caller…
// False positives: Users legitimately rotating their own access keys.
// Source: rules/persistence/iam-create-access-key.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="CreateAccessKey" and eventSource=="iam.amazonaws.com"
