// AWS Virtual MFA Device Created  [tier: hunt]  ATT&CK: T1556.006
// Detects creation of a virtual MFA device (CreateVirtualMFADevice). On its own benign, but combined with EnableMFADevice against another…
// False positives: Normal MFA enrollment by users.
// Source: rules/persistence/iam-create-virtual-mfa-device.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName=="CreateVirtualMFADevice" and eventSource=="iam.amazonaws.com"
