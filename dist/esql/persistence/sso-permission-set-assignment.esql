// AWS IAM Identity Center Permission Set or Assignment Created  [tier: alert]  ATT&CK: T1098
// Detects creation of IAM Identity Center (SSO) permission sets or account assignments (CreatePermissionSet, CreateAccountAssignment,…
// False positives: Planned SSO access provisioning by the identity team.
// Source: rules/persistence/sso-permission-set-assignment.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where (eventName in ("CreatePermissionSet", "CreateAccountAssignment", "AttachManagedPolicyToPermissionSet", "PutInlinePolicyToPermissionSet")) and eventSource=="sso.amazonaws.com"
