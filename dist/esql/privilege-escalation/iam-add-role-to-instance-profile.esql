// AWS IAM Role Added to Instance Profile  [tier: hunt]  ATT&CK: T1098
// Detects associating an IAM role with an instance profile or attaching that profile to an instance…
// False positives: Standard EC2 provisioning assigning instance roles.
// Source: rules/privilege-escalation/iam-add-role-to-instance-profile.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where eventName in ("AddRoleToInstanceProfile", "AssociateIamInstanceProfile")
