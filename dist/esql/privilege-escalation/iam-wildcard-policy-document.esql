// AWS IAM Wildcard (Admin) Policy Document Created  [tier: alert]  ATT&CK: T1098.003
// Detects creation of a custom IAM policy that grants full administrative access via a wildcard statement (Action *, Resource *), whether…
// False positives: Legitimate creation of an admin/break-glass policy (should be rare and reviewed).
// Source: rules/privilege-escalation/iam-wildcard-policy-document.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
from * metadata _id, _index, _version | where (eventName in ("PutUserPolicy", "PutRolePolicy", "PutGroupPolicy", "CreatePolicy", "CreatePolicyVersion")) and eventSource=="iam.amazonaws.com" and requestParameters.policyDocument rlike "\"Action\":\\s*\"\\*\"" and requestParameters.policyDocument rlike "\"Resource\":\\s*\"\\*\""
