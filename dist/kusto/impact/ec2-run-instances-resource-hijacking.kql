eventName =~ "RunInstances" and eventSource =~ "ec2.amazonaws.com" and (''requestParameters.instanceType'' startswith "p2" or ''requestParameters.instanceType'' startswith "p3" or ''requestParameters.instanceType'' startswith "p4" or ''requestParameters.instanceType'' startswith "p5" or ''requestParameters.instanceType'' startswith "g3" or ''requestParameters.instanceType'' startswith "g4" or ''requestParameters.instanceType'' startswith "g5" or ''requestParameters.instanceType'' startswith "g6" or ''requestParameters.instanceType'' startswith "x1" or ''requestParameters.instanceType'' startswith "x2" or ''requestParameters.instanceType'' startswith "inf1" or ''requestParameters.instanceType'' startswith "inf2" or ''requestParameters.instanceType'' startswith "trn1" or ''requestParameters.instanceType'' startswith "dl1")
