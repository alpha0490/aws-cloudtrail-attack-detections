// AWS DynamoDB Table Exported  [tier: hunt]  ATT&CK: T1530
// Detects export of a DynamoDB table to S3 (ExportTableToPointInTime), a bulk data-collection technique.
// False positives: Legitimate analytics/backup exports.
// Source: rules/collection/dynamodb-export-table.yml — generated by scripts/build_dist.py; adjust field names to your CloudTrail schema.
eventName=/^ExportTableToPointInTime$/i eventSource=/^dynamodb\.amazonaws\.com$/i
