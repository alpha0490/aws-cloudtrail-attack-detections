eventName=/^PutUserPolicy$/i or eventName=/^PutRolePolicy$/i or eventName=/^PutGroupPolicy$/i or eventName=/^CreatePolicy$/i or eventName=/^CreatePolicyVersion$/i eventSource=/^iam\.amazonaws\.com$/i requestParameters.policyDocument=/\"Action\":\s*\"\*\"/ requestParameters.policyDocument=/\"Resource\":\s*\"\*\"/
